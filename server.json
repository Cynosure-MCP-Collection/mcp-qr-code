{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/qr-code",
    "description": "MCP server for generating and reading QR codes",
    "version": "1.0.2",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/qr-code@1.0.2/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/qr-code",
            "version": "1.0.2",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "QR_CODE_OUTPUT_DIR",
                    "description": "Directory where generated QR code images are saved. Defaults to a temporary directory.",
                    "isRequired": false,
                    "format": "string",
                    "isSecret": false
                }
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-qr-code",
        "source": "github"
    }
}

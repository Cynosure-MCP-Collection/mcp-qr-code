{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/qr-code",
    "description": "MCP server for generating and reading QR codes",
    "version": "1.0.0",
    "icons": [
        {
            "src": "https://raw.githubusercontent.com/andreasjhagen/Cynosure-MCPs/main/mcp-qr-code/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/qr-code",
            "version": "1.0.0",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "QR_CODE_OUTPUT_DIR",
                    "description": "Directory where generated QR code images are saved. Defaults to a temporary directory.",
                    "isRequired": false,
                    "format": "string",
                    "isSecret": false
                }
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/Cynosure-MCPs",
        "source": "github",
        "subfolder": "mcp-qr-code"
    }
}
